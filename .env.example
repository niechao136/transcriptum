# Transcriptum 部署环境变量（复制为 .env 后按需修改）
#
# 注意：这里只放非敏感配置。API Key 通过 ASR_API_KEY / LLM_API_KEY 注入，
# 不要提交到版本库。

# 宿主机端口
TRANSCRIPTUM_PORT=8080

# ---------- ASR ----------
# mock（默认，无需模型）/ moss / openai_audio / custom_http
TRANSCRIPTUM_ASR_ADAPTER=mock
# 宿主机上的 vLLM/SGLang 服务地址
TRANSCRIPTUM_ASR_BASE_URL=http://host.docker.internal:9000
ASR_API_KEY=

# ---------- LLM ----------
# mock（默认）/ openai_compatible
TRANSCRIPTUM_LLM_ADAPTER=mock
TRANSCRIPTUM_LLM_BASE_URL=http://host.docker.internal:8000/v1
TRANSCRIPTUM_LLM_MODEL=Qwen2.5-7B-Instruct
LLM_API_KEY=

# ---------- 网络白名单 ----------
# 任何非 localhost 的模型端点都必须列在这里，否则启动期拒绝（安全边界）
# 逗号分隔，支持 *.internal 这类通配
TRANSCRIPTUM_ALLOWED_EGRESS=localhost,127.0.0.1,host.docker.internal

# 接入内网真实模型时大概长这样：
# TRANSCRIPTUM_ASR_ADAPTER=moss
# TRANSCRIPTUM_ASR_BASE_URL=http://gpu-box.internal:9000
# TRANSCRIPTUM_LLM_ADAPTER=openai_compatible
# TRANSCRIPTUM_LLM_BASE_URL=http://gpu-box.internal:8000/v1
# TRANSCRIPTUM_ALLOWED_EGRESS=localhost,127.0.0.1,*.internal
