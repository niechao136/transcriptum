  "cards": [
    {
      "dot": "cyan",
      "title": "接入与前端",
      "items": [
        "Nginx 终止 HTTPS，托管 SPA 静态资源",
        "React 13 视图；权限只控制「显示与否」，真正的判定在服务端",
        "会议详情页承担逐句校对、说话人绑定、跳播与定稿"
      ]
    },
    {
      "dot": "emerald",
      "title": "API 与领域层",
      "items": [
        "统一鉴权中间件构造 Ctx(user, role, scope, ver)",
        "领域层为纯业务规则，不碰 IO，便于单测",
        "权限/绑定变更 → ver+1 → 该用户全端强制登出"
      ]
    },
    {
      "dot": "amber",
      "title": "任务与推理",
      "items": [
        "Redis 队列 + Worker：转写/校对/纪要/索引全部异步",
        "MOSS 实测 RTF 0.197（42 分钟音频约 8.3 分钟）",
        "推理为独立服务，应用扩容不拖 GPU；推理不可用时暂停取任务"
      ]
    },
    {
      "dot": "rose",
      "title": "数据与安全边界",
      "items": [
        "PostgreSQL + pgvector：检索先按 scope 过滤再排序，绝不先全局后过滤",
        "MinIO 存音频；录音删除只删 audio_ref，句子与纪要永久保留",
        "审计表级禁改删；登录失败也记"
      ]
    },
    {
      "dot": "violet",
      "title": "本系统最独特之处：依据链",
      "items": [
        "纪要每项绑定 (seg_id, key)，如「議題摘要」→ 句 0 必须仍含「跌倒」",
        "句子被删改后重新生成，该结论自动消失",
        "产品灵魂：没有依据的结论不该存在"
      ]
    }
  ]
